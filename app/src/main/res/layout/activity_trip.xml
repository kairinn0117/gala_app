<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cover Image -->
    <ImageView
        android:id="@+id/imgCover"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnEditTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="@id/imgCover"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnBackTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="@id/imgCover"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Anchor below top buttons -->
    <View
        android:id="@+id/topButtonsAnchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackTrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Trip Info overlay (won't overlap the top buttons anymore) -->
    <LinearLayout
        android:id="@+id/layoutTripInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_margin="12dp"
        android:background="#66000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topButtonsAnchor"
        app:layout_constraintBottom_toBottomOf="@id/imgCover">

        <TextView
            android:id="@+id/tvTripName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trip Name"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvTripDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date • Time"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:alpha="0.95"/>

        <!-- Category + Template badge -->
        <LinearLayout
            android:id="@+id/layoutCategoryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTripCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.95"/>

            <TextView
                android:id="@+id/tvTemplateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  TEMPLATE"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTripLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:alpha="0.95"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- REMOVED: tvTripCity (city spinner removed in CreateTrip) -->

        <TextView
            android:id="@+id/tvTripBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Budget"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            android:alpha="0.95"/>

        <!-- Small action (looks like button but not bulky) -->
        <TextView
            android:id="@+id/btnEnableBudget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Budgeting"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:padding="6dp"
            android:background="#33FFFFFF"
            android:visibility="gone"
            tools:visibility="visible"/>
    </LinearLayout>

    <!-- Destinations label -->
    <TextView
        android:id="@+id/tvDestinations"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Destinations"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgCover"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyDestinations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No destinations yet. Tap + to add."
        android:textSize="12sp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tvDestinations"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDestinations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDestinations"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnAddDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"/>


        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnPlanTrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan Trip" />

        <Button
            android:id="@+id/btnStartTrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"/>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>