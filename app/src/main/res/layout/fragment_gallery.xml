<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvGalleryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Gallery"
        android:textSize="26sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnGalleryFilter"/>

    <!-- Filter button -->
    <Button
        android:id="@+id/btnGalleryFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter"
        app:layout_constraintTop_toTopOf="@id/tvGalleryTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvGalleryTitle"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search -->
    <EditText
        android:id="@+id/etGallerySearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Search finished trips"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvGalleryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyFinished"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No finished trips yet."
        android:visibility="gone"
        android:alpha="0.7"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etGallerySearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFinishedTrips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmptyFinished"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>