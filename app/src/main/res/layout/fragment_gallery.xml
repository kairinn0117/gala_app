<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Title Image -->
    <ImageView
        android:id="@+id/ivGalleryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/gallery"
        android:contentDescription="Gallery Title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Filter Button -->
    <ImageButton
        android:id="@+id/btnGalleryFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:src="@drawable/filter"
        android:contentDescription="Filter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Search Background Image -->
    <ImageView
        android:id="@+id/ivSearchBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@id/etGallerySearch"
        app:layout_constraintEnd_toEndOf="@id/etGallerySearch"
        app:layout_constraintStart_toStartOf="@id/etGallerySearch"
        app:layout_constraintTop_toTopOf="@id/etGallerySearch"
        app:srcCompat="@drawable/searchbox" />

    <!-- Search Box -->
    <EditText
        android:id="@+id/etGallerySearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Search finished trips"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/ivGalleryTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvEmptyFinished"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No finished trips yet."
        android:alpha="0.7"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/etGallerySearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFinishedTrips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/etGallerySearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>